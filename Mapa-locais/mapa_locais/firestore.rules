rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function valid(d) {
      return d.keys().hasAll(['nome','categoria','cidade','avaliacao','distancia','horario','descricao','favorito','latitude','longitude','endereco'])
        && d.keys().hasOnly(['nome','categoria','cidade','avaliacao','distancia','horario','descricao','favorito','latitude','longitude','endereco'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 100
        && d.categoria in ['Academia','Restaurante','Parque','Cultura','Hospital']
        && d.cidade in ['São Paulo','Campinas','Jundiaí']
        && d.avaliacao is number && d.avaliacao >= 0 && d.avaliacao <= 5
        && d.distancia is number && d.distancia >= 0 && d.distancia <= 1000
        && d.horario is string && d.horario.size() > 0 && d.horario.size() <= 80
        && d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 2000
        && d.endereco is string && d.endereco.size() > 0 && d.endereco.size() <= 160
        && d.favorito is bool
        && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
        && d.longitude is number && d.longitude >= -180 && d.longitude <= 180;
    }
    match /locais/{id} {
      allow read: if signedIn();
      allow create: if admin() && valid(request.resource.data);
      allow update: if valid(request.resource.data) && (admin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favorito'])));
      allow delete: if admin();
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
